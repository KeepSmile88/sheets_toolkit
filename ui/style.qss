QMainWindow {
    background-color: #f8f9fa;
}

QLabel {
    font-size: 14px;
    color: #333;
}

QPushButton {
    background-color: #4CAF50;
    color: white;
    padding: 2px 8px;
    font-size: 14px;
    border: none;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #45a049;
    padding: 2px 8px;
}

QComboBox, QLineEdit, QDateTimeEdit {
    padding: 6px;
    font-size: 14px;
}

QTextEdit {
    background-color: #ffffff;
    font-family: Consolas;
    font-size: 13px;
    border: 1px solid #ccc;
}

QTableWidget {
    background-color: #ffffff;
    font-size: 13px;
    border: 1px solid #ccc;
    gridline-color: #ddd;
}
